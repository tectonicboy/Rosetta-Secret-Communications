# -*- MakeFile -*-

# INTENDED TO BE CALLED BY THE PRIMARY PROJECT MAKEFILE IN THE TOP-LEVEL DIR.
# IN A SEPARATE MAKEFILE HERE FOR READABILITY AND MODULARITY.
#
# MAKEFILE ENTRIES COMMON TO ALL 3 PROJECT MAKEFILES ARE IN config.mk

include ../common-build-config.mk

.PHONY: all clean

BIN_DIR = ../bin
FIND_NEW_DH_PRIMES_SRC = find-new-dh-primes.c
FIND_NEW_DH_PRIMES_BIN = tools/find-new-dh-primes

all:
	$(CC) $(FIND_NEW_DH_PRIMES_SRC) -o $(BIN_DIR)/$(FIND_NEW_DH_PRIMES_BIN) \
	$(OPTIMIZATION_LEVEL) $(COMPILER_OPTIMIZATION_REPORT) \
	$(CFLAGS) $(ARCHITECTURE_FLAGS) $(CSTD) $(EXTRA_FLAGS) \
    $(GNU_OPTIMIZATION_FLAGS) $(LDFLAGS) $(LDLIBS)

clean:
	rm -rf $(BIN_DIR)/$(FIND_NEW_DH_PRIMES_BIN)
